# Copy this file to .env and fill in the provider keys you plan to use.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google AI Studio)
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional override for custom/compatible models; USD per 1 million tokens.
# Verify your provider's current rate card before setting these values.
# LLM_INPUT_PRICE_PER_MILLION_USD=0.30
# LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50

EMBEDDING_MODEL=all-MiniLM-L6-v2
